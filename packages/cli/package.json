{
    "name": "qodfy",
    "version": "0.0.1",
    "description": "Open-source launch readiness scanner for AI-built apps.",
    "type": "module",
    "bin": {
      "qodfy": "./dist/index.js"
    },
    "files": [
      "dist"
    ],
    "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "dev": "tsx src/index.ts",
      "start": "node dist/index.js"
    },
    "dependencies": {
      "@qodfy/core": "workspace:*",
      "commander": "latest",
      "picocolors": "latest"
    },
    "devDependencies": {
      "@types/node": "latest",
      "tsup": "latest",
      "tsx": "latest",
      "typescript": "latest"
    }
  }